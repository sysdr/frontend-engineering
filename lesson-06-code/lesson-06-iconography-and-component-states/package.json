{
  "name": "pulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build --summarize",
    "dev": "node apps/control-tower/server/serve.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/check-icons.mjs",
    "lint": "node scripts/check-codeowners.mjs && node scripts/check-boundaries.mjs && node scripts/generate-tokens.mjs --check && node scripts/check-icons.mjs && eslint . && node scripts/check-contrast.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "turbo run test && vitest run",
    "test:e2e": "playwright test",
    "try-broken-pair": "node scripts/try-broken-pair.mjs",
    "try-off-grid": "node scripts/try-off-grid.mjs",
    "try-odd-icon": "node scripts/try-odd-icon.mjs",
    "try-flat-disabled": "node scripts/try-flat-disabled.mjs"
  },
  "devDependencies": {
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "pngjs": "7.0.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
